# ── Database ──
DATABASE_URL=postgres://USER:PASS@HOST/DB?sslmode=require

# ── Better Auth (user authentication) ──
BETTER_AUTH_SECRET=run-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (Better Auth — for users logging into the consent screen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth 2.1 Server (for MCP clients) ──
OAUTH_JWT_SECRET=run-openssl-rand-base64-32
OAUTH_ISSUER=http://localhost:3000
OAUTH_ACCESS_TOKEN_TTL=900
OAUTH_REFRESH_TOKEN_TTL=2592000

# ── Vectorless backend (where this MCP forwards calls) ──
VECTORLESS_API_URL=http://localhost:8080
VECTORLESS_SERVICE_API_KEY=
